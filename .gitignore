# Personal notes
notes.kg

# Tests: data downloaded or written while the tests run. The fixtures in
# tests/artifacts/models/ are tracked.
tests/artifacts/catalogs/
tests/artifacts/zenodo/
tests/artifacts/zenodo_test/
tests/artifacts/models/zenodo_test/

# Tutorials: what running them writes. Their inputs (catalogues, model files and the pymock
# sources) are tracked, so name the generated paths here instead of broad patterns, which
# would also hide new inputs.
tutorials/case*/results/
# Model environments that floatCSEP creates in a model's folder: <model>_<8-character hash>
tutorials/**/*_[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]/
# ... but not inputs named by a date, such as data_20240101/ (a hash is rarely one)
!tutorials/**/*_19[0-9][0-9][01][0-9][0-3][0-9]/
!tutorials/**/*_20[0-9][0-9][01][0-9][0-3][0-9]/
# Input catalogues that floatCSEP writes for source-code models
tutorials/**/input/catalog.csv
# Forecasts written by the pymock models (case_f's ETAS forecasts are inputs)
tutorials/case*/pymock*/forecasts/
# Catalogues fetched by a catalogue query
tutorials/case_d/catalog.json
tutorials/case_e/catalog.json
# Models downloaded from Zenodo or cloned from Git
tutorials/case_d/models/
tutorials/case_h/models/
tutorials/case_j/models/
tutorials/case_jken/models/
tutorials/case_k/quadtree_paper.md

# Tutorial K: prepare.py copies unpublished forecasts, figures and results from the global
# experiment, and native_grid.py writes results next to them. Never commit these.
tutorials/case_k/catalog.csv
tutorials/case_k/models/
tutorials/case_k/results/
tutorials/case_k/about/
tutorials/case_k/imported/
tutorials/case_k/external_forecasts.json

