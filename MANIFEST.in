include README.md
include CODE_OF_CONDUCT.md
include CITATION.cff
include requirements.txt
include requirements_dev.txt
include environment.yml
include pyproject.toml
include LICENSE
include CREDITS.md
include CONTRIBUTING.md

graft floatcsep
graft tests
graft docs
prune docs/_build
prune docs/reference/generated

global-exclude .git*
global-exclude *.pyc
global-exclude *.html
global-exclude *.so
global-exclude *~
global-exclude .DS_Store

# Next.js dashboard: ship the sources only, never local installs, builds or caches
prune floatcsep/postprocess/nextjs/node_modules
prune floatcsep/postprocess/nextjs/.next
prune floatcsep/postprocess/nextjs/.next-prod
prune floatcsep/postprocess/nextjs/.cache
exclude floatcsep/postprocess/nextjs/next-env.d.ts
exclude floatcsep/postprocess/nextjs/tsconfig.tsbuildinfo
